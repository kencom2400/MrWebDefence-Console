node_modules
.pnpm-store

# Build outputs
dist
build

# Environment variables
.env
.env.*

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDEs
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
